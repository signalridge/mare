---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { locale } = Astro.locals.starlightRoute;
const lang = locale === 'zh' || locale === 'ja' ? locale : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;

const LABELS = {
	en: { aria: 'Primary navigation', docs: 'Docs', extend: 'Extend', reference: 'Reference', ecosystem: 'Ecosystem' },
	zh: { aria: '主导航', docs: '文档', extend: '扩展', reference: '参考', ecosystem: '生态' },
	ja: { aria: 'メインナビゲーション', docs: 'ドキュメント', extend: '拡張', reference: 'リファレンス', ecosystem: 'エコシステム' },
}[lang];

const navItems = [
	{
		label: LABELS.docs,
		href: `${base}/${lang}/get-started/quickstart/`,
		active:
			pathname.includes(`/${lang}/get-started/`) ||
			pathname.includes(`/${lang}/use/`) ||
			pathname.includes(`/${lang}/configure/`) ||
			pathname.includes(`/${lang}/integrate/`),
	},
	{
		label: LABELS.extend,
		href: `${base}/${lang}/extend/plugins/`,
		active: pathname.includes(`/${lang}/extend/`),
	},
	{
		label: LABELS.reference,
		href: `${base}/${lang}/reference/cli/`,
		active: pathname.includes(`/${lang}/reference/`),
	},
	{
		label: LABELS.ecosystem,
		href: `${base}/${lang}/#ecosystem`,
		active: false,
	},
];
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
		<nav class="mare-top-nav print:hidden" aria-label={LABELS.aria}>
			{
				navItems.map((item) => (
					<a href={item.href} aria-current={item.active ? 'true' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
	<div class="sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons"><SocialIcons /></div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
			gap: 1.5rem;
		}

		.mare-top-nav {
			display: none;
			align-items: center;
			gap: 0.2rem;
		}

		.mare-top-nav a {
			padding: 0.32rem 0.62rem;
			border-radius: 0.45rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 500;
			line-height: 1.3;
			text-decoration: none;
			white-space: nowrap;
			transition:
				background-color 150ms cubic-bezier(0.22, 1, 0.36, 1),
				color 150ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.mare-top-nav a:hover {
			background: var(--mare-surface);
			color: var(--sl-color-white);
		}

		.mare-top-nav a[aria-current='true'] {
			background: var(--sl-color-accent-low);
			color: var(--sl-color-text-accent);
			font-weight: 600;
		}

		@media (min-width: 62rem) {
			.mare-top-nav {
				display: flex;
			}
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}
</style>
