---
const PAGE_TITLE_ID = '_top';

const { entry, locale } = Astro.locals.starlightRoute;
const lang = locale === 'zh' || locale === 'ja' ? locale : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const relPath = Astro.url.pathname
	.replace(new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}/?`), '')
	.replace(/^\/+|\/+$/g, '');
const parts = relPath.split('/').filter(Boolean);
const section = parts[1] || '';
const slug = parts.slice(1).join('/');
const rawUrl = slug ? `${base}/raw/${lang}/${slug}.md` : '';

const SECTION_LABELS: Record<string, Record<'en' | 'zh' | 'ja', string>> = {
	'get-started': { en: 'Get started', zh: '开始使用', ja: 'はじめに' },
	use: { en: 'Use mare', zh: '使用 mare', ja: 'mare を使う' },
	configure: { en: 'Configure', zh: '配置', ja: '設定' },
	extend: { en: 'Extend', zh: '扩展', ja: '拡張' },
	integrate: { en: 'Integrate', zh: '集成', ja: '連携' },
	reference: { en: 'Reference', zh: '参考', ja: 'リファレンス' },
};

const GENERATED_SLUGS = new Set([
	'reference/cli',
	'reference/slash-commands',
	'reference/rpc',
	'reference/events',
	'configure/options',
	'extend/lua-api',
]);

const UI_TEXT = {
	en: { generated: 'Generated from source', copy: 'Copy Markdown', copied: 'Copied', failed: 'Error' },
	zh: { generated: '源码生成', copy: '复制 Markdown', copied: '已复制', failed: '失败' },
	ja: { generated: 'ソースから生成', copy: 'Markdown をコピー', copied: 'コピー済み', failed: '失敗' },
}[lang];

const sectionLabel = SECTION_LABELS[section]?.[lang] || '';
const isGenerated = GENERATED_SLUGS.has(slug);
---

<div class="mare-page-header">
	<div class="mare-page-title-row">
		<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
		{
			rawUrl && (
				<button
					type="button"
					class="mare-copy-md print:hidden"
					data-raw-url={rawUrl}
					data-copy-label={UI_TEXT.copy}
					data-copied-label={UI_TEXT.copied}
					data-failed-label={UI_TEXT.failed}
				>
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
						<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
					</svg>
					<span class="mare-copy-md-text">{UI_TEXT.copy}</span>
				</button>
			)
		}
	</div>
	{
		(sectionLabel || isGenerated) && (
			<p class="mare-page-context print:hidden">
				{sectionLabel && <span>{sectionLabel}</span>}
				{sectionLabel && isGenerated && <span aria-hidden="true"> · </span>}
				{isGenerated && <span class="mare-generated-note">{UI_TEXT.generated}</span>}
			</p>
		)
	}
</div>

<script>
	function bindCopyButtons() {
		for (const btn of document.querySelectorAll<HTMLButtonElement>('.mare-copy-md')) {
			if (btn.dataset.bound === '1') continue;
			btn.dataset.bound = '1';
			btn.addEventListener('click', async () => {
				const url = btn.dataset.rawUrl;
				const labelEl = btn.querySelector('.mare-copy-md-text');
				if (!url || !labelEl) return;
				const copyLabel = btn.dataset.copyLabel || 'Copy Markdown';
				const copiedLabel = btn.dataset.copiedLabel || 'Copied';
				const failedLabel = btn.dataset.failedLabel || 'Error';

				const loadMarkdown = async () => {
					if (btn.dataset.cachedMd) return btn.dataset.cachedMd;
					const res = await fetch(url);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const text = await res.text();
					btn.dataset.cachedMd = text;
					return text;
				};

				try {
					if (typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
						const blobPromise = loadMarkdown().then((text) => new Blob([text], { type: 'text/plain' }));
						await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blobPromise })]);
					} else {
						await navigator.clipboard.writeText(await loadMarkdown());
					}
					btn.dataset.state = 'copied';
					labelEl.textContent = copiedLabel;
					window.setTimeout(() => {
						btn.dataset.state = '';
						labelEl.textContent = copyLabel;
					}, 1800);
				} catch {
					btn.dataset.state = 'error';
					labelEl.textContent = failedLabel;
					window.setTimeout(() => {
						btn.dataset.state = '';
						labelEl.textContent = copyLabel;
					}, 1800);
				}
			});
		}
	}
	bindCopyButtons();
	document.addEventListener('astro:page-load', bindCopyButtons);
</script>

<style>
	@layer starlight.core {
		h1 {
			margin: 0;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	.mare-page-title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
	}

	.mare-page-context {
		margin: 0.45rem 0 0;
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
		line-height: 1.4;
	}

	.mare-generated-note {
		color: var(--sl-color-gray-3);
	}

	.mare-copy-md {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.45rem;
		padding: 0.34rem 0.7rem;
		background: var(--mare-surface);
		color: var(--sl-color-gray-2);
		font-family: var(--__sl-font);
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.3;
		cursor: pointer;
		flex-shrink: 0;
		transition:
			border-color 150ms cubic-bezier(0.22, 1, 0.36, 1),
			color 150ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 150ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.mare-copy-md:hover {
		border-color: var(--sl-color-gray-4);
		color: var(--sl-color-white);
	}

	.mare-copy-md[data-state='copied'] {
		border-color: color-mix(in srgb, var(--sl-color-accent) 65%, transparent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}
</style>
