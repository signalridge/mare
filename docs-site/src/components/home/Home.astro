<style is:global>
	/* Unified Lunar Dusk (薄暮) tokens shared with Starlight documentation pages.
	   Strict 3-size body scale below hero: --text-heading (1.5rem), --text-body (1rem), --text-sm (0.875rem). */
	:root {
		--bg: #ffffff;
		--bg-alt: #f6f7fb;
		--surface: #ffffff;
