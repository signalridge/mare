---
// Standalone product home page, one per locale (src/pages/[lang]/index.astro).
// Shares Mare's Lunar Dusk palette, Space Grotesk / Inter / JetBrains Mono
// typography, and Starlight's `starlight-theme` storage key with the docs.
import fs from 'node:fs';
import { COPY, HTML_LANG, LANGS, LANG_LABEL, type Lang } from './copy';
import { ARCHITECTURE_POSTER_URL, ARCHITECTURE_VIDEO_URL } from './media';

const ARCH_DIAGRAM_SVG = fs.readFileSync(
	new URL('../../../../docs/assets/diagrams/architecture.svg', import.meta.url),
	'utf8',
);

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = COPY[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? new URL(`${base}/${lang}/`, Astro.site).href : undefined;
const docs = (path: string) => `${base}/${path}`;
const REPO = 'https://github.com/signalridge/mare';
const RELEASES = `${REPO}/releases/latest`;
const hasArchVideo = ARCHITECTURE_VIDEO_URL.trim().length > 0;

const fontCss = [
	`@font-face{font-family:'Inter Variable';font-style:normal;font-weight:100 900;font-display:swap;src:url('${base}/fonts/inter-latin-wght-normal.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`,
	`@font-face{font-family:'Inter Variable';font-style:normal;font-weight:100 900;font-display:swap;src:url('${base}/fonts/inter-latin-ext-wght-normal.woff2') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1E00-1E9F,U+2C60-2C7F,U+A720-A7FF}`,
	`@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url('${base}/fonts/space-grotesk-600-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`,
	`@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:600;font-display:swap;src:url('${base}/fonts/space-grotesk-600-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+1E00-1E9F,U+2C60-2C7F,U+A720-A7FF}`,
	`@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-weight:100 800;font-display:swap;src:url('${base}/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2')}`,
].join('');

const PLUGIN_RAW = `-- ~/.config/mare/plugins/show-model.lua
return {
  name = "show-model",
  inject = { "llm", "commands" },
  apply = function(ctx)
    ctx.commands:register("which-model", {
      description = "Show the current model",
      run = function()
        local m = ctx.llm:current()
        ui.notify(m and m.ref or "no model")
      end,
    })
  end,
}`;

const PLUGIN_SAMPLE = `<span class="c">-- ~/.config/mare/plugins/show-model.lua</span>
<span class="k">return</span> {
  name = <span class="s">"show-model"</span>,
  inject = { <span class="s">"llm"</span>, <span class="s">"commands"</span> },
  apply = <span class="k">function</span>(ctx)
    ctx.commands:<span class="f">register</span>(<span class="s">"which-model"</span>, {
      description = <span class="s">"Show the current model"</span>,
      run = <span class="k">function</span>()
        <span class="k">local</span> m = ctx.llm:<span class="f">current</span>()
        ui.<span class="f">notify</span>(m <span class="k">and</span> m.ref <span class="k">or</span> <span class="s">"no model"</span>)
      <span class="k">end</span>,
    })
  <span class="k">end</span>,
}`;

const AGENT_SAMPLE = `<span class="c">---</span>
<span class="f">name</span>: security-auditor
<span class="f">description</span>: Audits changes for secret leaks.
<span class="f">tools</span>: [read, ls]
<span class="f">effort</span>: high
<span class="c">---</span>
You are a read-only security reviewer.`;

const SESSION_COMMANDS = ['/fork', '/tree', '/rewind', 'mare -c'];
const PROVIDERS = ['openai', 'anthropic', 'google', 'opencode-go', 'deepseek', 'kimi', 'kimi-code', 'openrouter', 'ollama', 'lmstudio'];
const EFFORT = ['off', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'];

const INTEGRATE_RAW = `mare -p "summarize the open TODOs in @src"
mare --json "fix the failing test" | jq -c .
mare acp
mare --rpc
mare --web`;

const INTEGRATE_SAMPLE = `<span class="c"># one-shot, for scripts</span>
<span class="p">$</span> mare -p <span class="s">"summarize the open TODOs in @src"</span>
<span class="c"># JSON event stream for CI</span>
<span class="p">$</span> mare --json <span class="s">"fix the failing test"</span> | jq -c .
<span class="c"># editors (Agent Client Protocol)</span>
<span class="p">$</span> mare acp
<span class="c"># mare RPC 3.0 (JSON-RPC 2.0) on stdio, or HTTP + WebSocket</span>
<span class="p">$</span> mare --rpc
<span class="p">$</span> mare --web`;

const STARTUP_COMMANDS = ['mare --profile-startup', 'mare --startuptime startup.log', 'mare --clean'];

const INSTALL_SH = 'curl -fsSL https://signalridge.github.io/mare/install.sh | sh';
const BREW = ['brew tap signalridge/tap', 'brew trust signalridge/tap', 'brew install --cask mare'];
const NUR = ['nix profile install github:signalridge/nur-packages#mare'];

const OSES = [
	{
		id: 'macos',
		label: 'macOS',
		methods: [
			{ name: t.install.script, lines: [INSTALL_SH] },
			{ name: 'Homebrew', lines: BREW },
			{ name: 'Nix (NUR)', lines: NUR },
		],
	},
	{
		id: 'linux',
		label: 'Linux',
		methods: [
			{ name: t.install.script, lines: [INSTALL_SH] },
			{ name: 'Homebrew', lines: BREW },
			{ name: 'Arch Linux (AUR)', lines: ['yay -S mare-bin'] },
			{ name: 'Nix (NUR)', lines: NUR },
		],
	},
	{
		id: 'windows',
		label: 'Windows',
		methods: [
			{ name: t.install.script, lines: ['irm https://signalridge.github.io/mare/install.ps1 | iex'] },
			{
				name: 'Scoop',
				lines: [
					'scoop bucket add signalridge https://github.com/signalridge/scoop-bucket',
					'scoop install signalridge/mare',
				],
			},
		],
	},
	{
		id: 'container',
		label: t.install.container,
		methods: [
			{
				name: 'GHCR',
				lines: ['docker run --rm -it -v "$PWD:/workspace" -w /workspace ghcr.io/signalridge/mare:latest'],
			},
		],
	},
];

const TARGETS = [
	{ os: 'macos', arch: 'arm', name: 'macOS', detail: t.install.apple, target: 'aarch64-apple-darwin', ext: 'tar.gz' },
	{ os: 'macos', arch: 'x86', name: 'macOS', detail: t.install.intel, target: 'x86_64-apple-darwin', ext: 'tar.gz' },
	{ os: 'linux', arch: 'x86', name: 'Linux', detail: 'x86-64', target: 'x86_64-unknown-linux-gnu', ext: 'tar.gz' },
	{ os: 'linux', arch: 'arm', name: 'Linux', detail: 'ARM64', target: 'aarch64-unknown-linux-gnu', ext: 'tar.gz' },
	{ os: 'windows', arch: 'x86', name: 'Windows', detail: 'x64', target: 'x86_64-pc-windows-msvc', ext: 'zip' },
	{ os: 'windows', arch: 'arm', name: 'Windows', detail: 'ARM64', target: 'aarch64-pc-windows-msvc', ext: 'zip' },
];

const ICONS: Record<string, string> = {
	macos: '<path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3.1.7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.8zM14.1 5.8c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3z"/>',
	linux: '<path d="M12 2.2c-2.2 0-3.6 1.9-3.6 4.6 0 1.4.4 2.4-.4 3.7-1 1.6-2.7 3.4-2.7 6 0 .7.1 1.3.4 1.8-.8.3-1.7.7-1.7 1.4 0 1 1.8 1 3.1 1.6 1 .5 1.8 1 2.7.6.5-.2.8-.6 1-1h2.4c.2.4.5.8 1 1 .9.4 1.7-.1 2.7-.6 1.3-.6 3.1-.6 3.1-1.6 0-.7-.9-1.1-1.7-1.4.3-.5.4-1.1.4-1.8 0-2.6-1.7-4.4-2.7-6-.8-1.3-.4-2.3-.4-3.7 0-2.7-1.4-4.6-3.6-4.6zm-1.5 3.7c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zm3 0c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zM12 8.6c.9 0 2 .5 2 .9s-1.1 1.1-2 1.1-2-.7-2-1.1.9-.9 2-.9z"/>',
	windows: '<path d="M3 5.5 10.4 4.5v7.1H3zM11.3 4.4 21 3v8.6h-9.7zM3 12.4h7.4v7.1L3 18.5zm8.3 0H21V21l-9.7-1.4z"/>',
	container: '<path d="M4 10h2.5v2.4H4zm3 0h2.5v2.4H7zm3 0h2.5v2.4H10zm3 0h2.5v2.4H13zM7 7.2h2.5v2.4H7zm3 0h2.5v2.4H10zm3 0h2.5v2.4H13zm0-2.8h2.5v2.4H13zM21.6 11c-.5-.4-1.6-.5-2.5-.3-.1-.9-.6-1.6-1.4-2.2l-.3-.2-.2.3c-.4.6-.5 1.6-.4 2.3.1.3.2.7.4 1-.4.2-1 .4-1.9.4H2.2l-.1.4c-.1 1.6.2 3.5 1.2 4.8.9 1.2 2.4 1.9 4.5 1.9 4.4 0 7.7-2 9.2-6.3.6 0 1.9 0 2.6-1.3l.2-.4z"/>',
};
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		{site && <link rel="canonical" href={site} />}
		{LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`${Astro.site?.origin ?? ''}${base}/${l}/`} />)}
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e0f17" media="(prefers-color-scheme: dark)" />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={t.description} />
		<meta property="og:type" content="website" />
		{site && <meta property="og:url" content={site} />}
		<link rel="icon" href={`${base}/mark.svg`} type="image/svg+xml" />
		<link rel="preload" href={`${base}/fonts/inter-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={`${base}/fonts/space-grotesk-600-latin.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={`${base}/fonts/jetbrains-mono-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin="anonymous" />
		<style is:inline set:html={fontCss} />
		<style is:inline>
			html{background:#0e0f17;color:#f3f4fb}
			html[data-theme='light']{background:#ffffff;color:#141624}
			svg{max-width:100%;height:auto}
			.icon-btn svg,.menu summary svg{width:18px;height:18px}
			.play svg,.tabs svg{width:16px;height:16px}
			.targets svg{width:22px;height:22px}
			#theme svg,.play .i-pause{display:none}
			.brand img{display:block;height:22px;width:auto}
			.brand .wordmark-light{display:none}
			html[data-theme='light'] .brand .wordmark-dark{display:none}
			html[data-theme='light'] .brand .wordmark-light{display:block}
		</style>
		<script is:inline>
			(function () {
				var root = document.documentElement;
				root.classList.add('js');
				var saved = null;
				try {
					saved = localStorage.getItem('starlight-theme');
				} catch (e) {}
				var choice = saved === 'light' || saved === 'dark' ? saved : 'auto';
				var system = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				root.dataset.themeChoice = choice;
				root.dataset.theme = choice === 'auto' ? system : choice;
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">{t.nav.skip}</a>

		<header class="nav" id="site-nav">
			<div class="wide nav-row">
				<a class="brand" href={`${base}/${lang}/`} aria-label="mare">
					<img class="wordmark-dark" src={`${base}/assets/brand/mare-wordmark-nav-dark.svg`} alt="mare" width="101" height="22" decoding="sync" />
					<img class="wordmark-light" src={`${base}/assets/brand/mare-wordmark-nav-light.svg`} alt="mare" width="101" height="22" decoding="sync" />
				</a>
				<nav aria-label={t.nav.aria}>
					<ul>
						<li class="wide-only"><a href="#architecture">{t.nav.architecture}</a></li>
						<li class="wide-only"><a href="#features">{t.nav.features}</a></li>
						<li class="wide-only"><a href="#install">{t.nav.install}</a></li>
						<li><a class="nav-docs" href={docs(`${lang}/get-started/overview/`)}>{t.nav.docs}</a></li>
						<li>
							<details class="menu">
								<summary aria-label={t.nav.language}>
									<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.7 15.7 0 0 0-1.3-3.9A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8 8 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4zm.8 2h3a15.7 15.7 0 0 0 1.3 3.9A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.3-3.9C8.8 5.3 8.4 6.6 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.9c.6-1.2 1-2.5 1.3-3.9h3a8 8 0 0 1-4.3 3.9zm1.7-5.9a16.5 16.5 0 0 0 0-4h3.4a8 8 0 0 1 0 4z" /></svg>
								</summary>
								<ul>
									{
										LANGS.map((l) => (
											<li>
												<a href={`${base}/${l}/`} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'page' : undefined}>
													{LANG_LABEL[l]}
												</a>
											</li>
										))
									}
								</ul>
							</details>
						</li>
						<li>
							<button type="button" class="icon-btn" id="theme" data-labels={JSON.stringify(t.nav.themes)} aria-label={t.nav.themes[0]}>
								<svg class="i-auto" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 2v14a7 7 0 0 1 0-14z" /></svg>
								<svg class="i-light" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM11 1h2v3h-2zm0 19h2v3h-2zM1 11h3v2H1zm19 0h3v2h-3zM4.2 2.8l2.1 2.1-1.4 1.4-2.1-2.1zm14.9 14.9 2.1 2.1-1.4 1.4-2.1-2.1zM2.8 19.8l2.1-2.1 1.4 1.4-2.1 2.1zM17.7 4.9l2.1-2.1 1.4 1.4-2.1 2.1z" /></svg>
								<svg class="i-dark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.7 14.3A8.5 8.5 0 0 1 9.7 3.3a9 9 0 1 0 11 11z" /></svg>
							</button>
						</li>
						<li>
							<a class="icon-btn" href={REPO} aria-label="GitHub">
								<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z" /></svg>
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="hero">
				<div class="wrap hero-inner">
					<h1>
						<span>{t.hero.title[0]}</span>{' '}
						<span class="accent-word">{t.hero.title[1]}</span>
					</h1>
					<p class="hero-lede">{t.hero.lede}</p>
					<div class="hero-actions">
						<a class="btn-primary" href={docs(`${lang}/get-started/quickstart/`)}>{t.hero.start}</a>
						<div class="hero-install">
							<code><span class="p">$</span> {INSTALL_SH}</code>
							<button type="button" class="inline-copy" data-copy={INSTALL_SH} data-copied={t.hero.copied} aria-label={t.hero.copyCmd}>
								<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
									<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
								</svg>
								<span>{t.install.copy}</span>
							</button>
						</div>
					</div>
				</div>

				<div class="wide shot" id="shot">
					<figure class="shot-frame">
						<div class="window-bar" aria-hidden="true">
							<i></i><i></i><i></i>
							<span>mare ~/median</span>
						</div>
						<div class="screen">
							<div
								id="demo-player"
								class="demo-player"
								data-cast={`${base}/home/session.cast`}
								data-cast-mobile={`${base}/home/session-mobile.cast`}
								role="region"
								aria-label={t.hero.video}
							>
								<img
									class="demo-poster"
									src={`${base}/home/poster.webp`}
									alt={t.hero.video}
									width="1084"
									height="612"
								/>
							</div>
						</div>
					</figure>
					<p class="caption">{t.hero.caption}</p>
				</div>
			</section>

			<section id="architecture" class="band band-alt">
				<div class="wide">
					<div class="section-head reveal">
						<h2>{t.architecture.title}</h2>
						<p>{t.architecture.lede}</p>
					</div>

					<figure class="arch-stage reveal" data-arch-slot="video-or-diagram">
						{
							hasArchVideo ? (
								<div class="arch-media">
									<video
										id="arch-video"
										muted
										loop
										playsinline
										preload="metadata"
										poster={ARCHITECTURE_POSTER_URL || undefined}
										aria-label={t.architecture.videoLabel}
										width="1280"
										height="720"
									>
										<source src={ARCHITECTURE_VIDEO_URL} />
									</video>
									<button type="button" class="play" id="arch-play" data-pause={t.hero.pause} data-play={t.hero.play} aria-label={t.hero.play}>
										<svg class="i-play" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
										<svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
									</button>
								</div>
							) : (
								<div class="arch-diagram">
									<div class="arch-diagram-scroll" set:html={ARCH_DIAGRAM_SVG} />
								</div>
							)
						}
						<figcaption class="caption">
							{hasArchVideo ? t.architecture.videoCaption : t.architecture.diagramCaption}
						</figcaption>
					</figure>

					<div class="layers-grid reveal">
						{
							t.architecture.layers.map((layer) => (
								<div class="layer-col">
									<div class="layer-head">
										<h3>{layer.name}</h3>
										<span class="layer-lang">{layer.lang}</span>
									</div>
									<p>{layer.desc}</p>
