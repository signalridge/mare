		--coral: #c24f3b;
		--nav-scrolled: #ffffff;
		--shadow: 0 24px 64px -24px rgba(20, 22, 36, 0.16), 0 4px 16px -6px rgba(20, 22, 36, 0.08);
		--k: #b4380b;
		--s: #15744a;
		--f: #5b38c6;
		--c: #636780;
		--ease: cubic-bezier(0.22, 1, 0.36, 1);

		--font-display: 'Space Grotesk', 'Inter Variable', 'PingFang SC', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans CJK SC', 'Yu Gothic UI', sans-serif;
		--font-body: 'Inter Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans CJK SC', 'Microsoft YaHei', 'Yu Gothic UI', sans-serif;
		--mono: 'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

		--text-heading: 1.5rem;
		--text-body: 1rem;
		--text-sm: 0.875rem;

		color-scheme: light;
	}
	:root[data-theme='dark'] {
		--bg: #0e0f17;
		--bg-alt: #131521;
		--surface: #171927;
		--code-bg: #131520;
		--term-bg: #11131e;
		--text: #f3f4fb;
		--text-2: #b2b7d1;
		--muted: #8d92b0;
		--line: #25273a;
		--accent: #7f83f5;
		--accent-hover: #6e72ee;
		--accent-soft: #222447;
		--link: #a5a9ff;
		--coral: #f59d88;
		--nav-scrolled: #0e0f17;
		--shadow: 0 32px 84px -24px rgba(0, 0, 0, 0.78), 0 0 0 1px rgba(255, 255, 255, 0.06);
		--k: #ff9e7a;
		--s: #8fe0a8;
		--f: #b8beff;
		--c: #8c91ae;
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	* {
		margin: 0;
		padding: 0;
	}
	html {
		scroll-behavior: smooth;
		-webkit-text-size-adjust: 100%;
	}
	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-body);
		font-size: var(--text-body);
		line-height: 1.65;
		font-variant-numeric: tabular-nums;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: clip;
	}
	a {
		color: var(--link);
		text-decoration: none;
		transition: color 160ms var(--ease);
	}
	a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	img,
	video,
	svg {
		display: block;
		max-width: 100%;
	}
	code,
	pre {
		font-family: var(--mono);
	}
	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 6px;
	}
	.skip {
		position: absolute;
		left: 16px;
		top: -48px;
		z-index: 30;
		background: var(--accent);
		color: #fff;
		padding: 8px 14px;
		border-radius: 8px;
		font-size: var(--text-sm);
	}
	.skip:focus {
		top: 12px;
	}
	.wrap {
		width: min(880px, 100% - 32px);
		margin-inline: auto;
	}
	.wide {
		width: min(1160px, 100% - 32px);
		margin-inline: auto;
	}

	/* Navigation: borderless at y = 0, crisp separation when scrolled. */
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
		background: transparent;
		border-bottom: 1px solid transparent;
		transition:
			background-color 120ms var(--ease),
			border-color 120ms var(--ease);
	}
	.nav.scrolled,
	html:not(.js) .nav {
		background: var(--nav-scrolled);
		border-bottom-color: var(--line);
	}
	.nav-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
		gap: 16px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--text);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.3125rem;
		letter-spacing: -0.03em;
	}
	.brand:hover {
		text-decoration: none;
	}
	.nav ul {
		display: flex;
		align-items: center;
		gap: 18px;
		list-style: none;
		font-size: var(--text-sm);
	}
	.nav ul a {
		color: var(--text-2);
		font-weight: 500;
		white-space: nowrap;
	}
	.nav ul a:hover {
		color: var(--text);
		text-decoration: none;
	}
	.nav ul .nav-docs {
		color: var(--text);
		font-weight: 600;
	}
	.icon-btn,
	.menu summary {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		border: 0;
		background: transparent;
		color: var(--text-2);
		cursor: pointer;
		transition:
			background-color 160ms var(--ease),
			color 160ms var(--ease);
	}
	.icon-btn:hover,
	.menu summary:hover {
		color: var(--text);
		background: color-mix(in srgb, var(--line) 55%, transparent);
	}
	.icon-btn svg,
	.menu summary svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
	#theme svg {
		display: none;
	}
	[data-theme-choice='auto'] #theme .i-auto,
	[data-theme-choice='light'] #theme .i-light,
	[data-theme-choice='dark'] #theme .i-dark {
		display: block;
	}
	html:not(.js) #theme {
		display: none;
	}
	.menu {
		position: relative;
	}
	.menu summary {
		list-style: none;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu ul {
		position: absolute;
		right: 0;
		top: 42px;
		display: grid;
		gap: 2px;
		min-width: 148px;
		padding: 6px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 12px;
		box-shadow: var(--shadow);
	}
	.menu ul a {
		display: block;
		padding: 7px 11px;
		border-radius: 8px;
		font-size: var(--text-sm);
		color: var(--text-2);
	}
	.menu ul a:hover,
	.menu ul a[aria-current] {
		background: var(--bg-alt);
		color: var(--text);
	}
	.menu ul a[aria-current] {
		font-weight: 600;
	}

	/* Hero: full-bleed Lunar Dusk horizon behind borderless header. */
	.hero {
		position: relative;
		text-align: center;
		padding: 112px 0 64px;
		background:
			radial-gradient(62rem 30rem at 50% -8rem, color-mix(in srgb, var(--accent) 20%, transparent), transparent 68%),
			radial-gradient(38rem 18rem at 76% 4%, color-mix(in srgb, var(--coral) 11%, transparent), transparent 72%),
			var(--bg);
	}
	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(2.625rem, 6.2vw, 4.75rem);
		line-height: 1.03;
		font-weight: 600;
		letter-spacing: -0.04em;
		max-width: 16ch;
	}
	:lang(zh) .hero h1,
	:lang(ja) .hero h1 {
		letter-spacing: -0.015em;
		font-size: clamp(1.65rem, 6vw, 4rem);
		max-width: 18ch;
		overflow-wrap: break-word;
		word-break: auto-phrase;
	}
	.accent-word {
		color: var(--link);
	}
	.hero-lede {
		margin-top: 20px;
		max-width: 56ch;
		font-size: var(--text-body);
		line-height: 1.65;
		color: var(--text-2);
	}
	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
		max-width: 100%;
	}
	.btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 22px;
		border-radius: 10px;
		background: var(--accent);
		color: #ffffff;
		font-size: var(--text-body);
		font-weight: 600;
		transition:
			background-color 180ms var(--ease),
			transform 160ms var(--ease);
	}
	.btn-primary:hover {
		background: var(--accent-hover);
		text-decoration: none;
	}
	.btn-primary:active {
		transform: scale(0.98);
	}
	.hero-install {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 44px;
		max-width: 100%;
		padding: 0 8px 0 14px;
		border-radius: 10px;
		border: 1px solid var(--line);
		background: var(--surface);
		font-size: var(--text-sm);
	}
	.hero-install code {
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: min(68vw, 560px);
	}
	.inline-copy {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 30px;
		padding: 0 10px;
		border: 1px solid var(--line);
		border-radius: 7px;
		background: var(--bg-alt);
		color: var(--text-2);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 500;
		cursor: pointer;
		flex: none;
		transition:
			border-color 160ms var(--ease),
			color 160ms var(--ease),
			background-color 160ms var(--ease);
	}
	.inline-copy:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.inline-copy.done {
		color: var(--s);
		border-color: color-mix(in srgb, var(--s) 55%, transparent);
	}
	html:not(.js) .inline-copy,
	html:not(.js) .copy,
	html:not(.js) .copy-sm {
		display: none;
	}

	/* Hero TUI Recording Stage */
	.shot {
		margin-top: 44px;
	}
	.shot-frame {
		border-radius: 14px;
		overflow: hidden;
		background: #1e1e2e;
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		max-width: 1040px;
		margin-inline: auto;
	}
	.window-bar {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 11px 16px;
		background: #181825;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}
	.window-bar i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.22);
	}
	.window-bar span {
		flex: 1;
		text-align: center;
		margin-right: 44px;
		font-size: var(--text-sm);
		color: #a6adc8;
		font-family: var(--mono);
	}
	.screen {
		position: relative;
		background: #1e1e2e;
		padding: 22px;
	}
	.demo-player {
		width: 100%;
		max-width: 100%;
		background: #1e1e2e;
	}
	.demo-poster {
		width: 100%;
		height: auto;
		aspect-ratio: 1084 / 612;
	}
	.demo-player div.ap-wrapper {
		width: 100%;
		max-width: 100%;
	}
	.demo-player div.ap-wrapper div.ap-player {
		width: 100%;
		max-width: 100%;
		border-radius: 0;
		background-color: #1e1e2e;
		overflow: hidden;
	}
	.demo-player .ap-overlay-start {
		display: none !important;
	}
	.demo-player div.ap-player div.ap-control-bar {
		height: 28px;
		background: rgba(24, 24, 37, 0.88);
		backdrop-filter: blur(6px);
	}
	.demo-player div.ap-control-bar button.ap-playback-button,
	.demo-player div.ap-control-bar button.ap-fullscreen-button {
		padding: 8px;
	}
	.demo-player div.ap-control-bar span.ap-timer {
		font-size: 12px;
	}
	.demo-player div.ap-control-bar .ap-progressbar .ap-bar .ap-gutter {
		top: 12.5px;
	}
	/* Catppuccin Mocha terminal palette (matches scripts/screenshots.py) */
	.asciinema-player-theme-catppuccin-mocha {
		--term-color-foreground: #cdd6f4;
		--term-color-background: #1e1e2e;
		--term-color-0: #45475a;
		--term-color-1: #f38ba8;
		--term-color-2: #a6e3a1;
		--term-color-3: #f9e2af;
		--term-color-4: #89b4fa;
		--term-color-5: #cba6f7;
		--term-color-6: #94e2d5;
		--term-color-7: #bac2de;
		--term-color-8: #585b70;
		--term-color-9: #f38ba8;
		--term-color-10: #a6e3a1;
		--term-color-11: #f9e2af;
		--term-color-12: #89b4fa;
		--term-color-13: #cba6f7;
		--term-color-14: #94e2d5;
		--term-color-15: #a6adc8;
	}
	.play {
		position: absolute;
		right: 14px;
		bottom: 14px;
		width: 38px;
		height: 38px;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: rgba(14, 15, 23, 0.78);
		backdrop-filter: blur(8px);
		color: #f3f4fb;
		display: grid;
		place-items: center;
		cursor: pointer;
		transition:
			background-color 160ms var(--ease),
			border-color 160ms var(--ease);
	}
	.play:hover {
		border-color: rgba(255, 255, 255, 0.42);
	}
	.play svg {
		width: 16px;
		height: 16px;
		fill: currentColor;
	}
	.play .i-pause,
	.play.playing .i-play {
		display: none;
	}
	.play.playing .i-pause {
		display: block;
	}
	.caption {
		margin-top: 14px;
		text-align: center;
		font-size: var(--text-sm);
		color: var(--muted);
	}

	/* Sections */
	.band {
		padding: 88px 0;
		border-top: 1px solid var(--line);
	}
	.band-alt {
		background: var(--bg-alt);
	}
	.section-head {
		max-width: 660px;
		margin-bottom: 44px;
	}
	.section-head h2 {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.4vw, 2.5rem);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.03em;
	}
	:lang(zh) .section-head h2,
	:lang(ja) .section-head h2 {
		letter-spacing: -0.01em;
		word-break: auto-phrase;
	}
	.section-head p {
		margin-top: 12px;
		color: var(--text-2);
		font-size: var(--text-body);
		max-width: 62ch;
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: var(--text-sm);
		font-weight: 600;
	}
	.more::after {
		content: '→';
		transition: transform 160ms var(--ease);
	}
	.more:hover::after {
		transform: translateX(3px);
	}

	/* Architecture showcase stage */
	.arch-stage {
		margin: 0;
	}
	.arch-media,
	.arch-diagram {
		position: relative;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--code-bg);
		box-shadow: var(--shadow);
	}
	.arch-media video {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
	}
	.arch-diagram-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	.arch-diagram-scroll svg {
		display: block;
		width: 100%;
		height: auto;
		user-select: text;
	}
	@media (max-width: 44rem) {
		.arch-diagram-scroll svg {
			min-width: 42rem;
		}
	}
	.layers-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 36px;
		border-top: 1px solid var(--line);
	}
	.layer-col {
		padding: 24px 24px 0 0;
	}
	.layer-col + .layer-col {
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}
	.layer-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 8px;
	}
	.layer-col h3 {
		font-family: var(--font-display);
		font-size: var(--text-heading);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}
	.layer-lang {
		font-family: var(--mono);
		font-size: var(--text-sm);
		color: var(--muted);
		white-space: nowrap;
	}
	.layer-col p {
		font-size: var(--text-body);
		color: var(--text-2);
	}
	.section-foot-link {
		margin-top: 28px;
	}

	/* Editorial capabilities layout (no card cages) */
	.split-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
		gap: 48px;
		align-items: center;
		padding-bottom: 56px;
		border-bottom: 1px solid var(--line);
	}
	.split-row-top {
		padding-top: 56px;
		align-items: start;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
	.split-copy {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
	}
	.split-copy h3,
	.col-item h3,
	.startup-copy h3,
	.first-run h3,
	.downloads-head h3 {
		font-family: var(--font-display);
		font-size: var(--text-heading);
		line-height: 1.22;
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	:lang(zh) :is(.split-copy h3, .col-item h3, .startup-copy h3, .first-run h3, .downloads-head h3, .layer-col h3),
	:lang(ja) :is(.split-copy h3, .col-item h3, .startup-copy h3, .first-run h3, .downloads-head h3, .layer-col h3) {
		letter-spacing: 0;
	}
	.split-copy p,
	.col-item p,
	.startup-copy p,
	.first-run p,
	.downloads-head p {
		color: var(--text-2);
		font-size: var(--text-body);
		max-width: 58ch;
	}

	.code-panel {
		border-radius: 12px;
		border: 1px solid var(--line);
		background: var(--code-bg);
		overflow: hidden;
		min-width: 0;
	}
	.code-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 9px 14px;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		font-family: var(--mono);
		font-size: var(--text-sm);
		color: var(--muted);
	}
	.copy-sm {
		border: 1px solid var(--line);
		border-radius: 6px;
		padding: 3px 10px;
		background: var(--bg);
		color: var(--text-2);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 500;
		cursor: pointer;
		transition:
			border-color 160ms var(--ease),
			color 160ms var(--ease);
	}
	.copy-sm:hover {
		border-color: var(--accent);
		color: var(--text);
	}
	.copy-sm.done {
		color: var(--s);
	}
	.code {
		padding: 16px 18px;
		font-size: var(--text-sm);
		line-height: 1.7;
		overflow-x: auto;
		color: var(--text);
	}
	.code.compact {
		margin-top: auto;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--code-bg);
		padding: 14px 16px;
	}
	.k { color: var(--k); }
	.s { color: var(--s); }
	.f { color: var(--f); }
	.c { color: var(--c); }
	.p { color: var(--s); user-select: none; }

	.three-col {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 1px solid var(--line);
	}
	.col-item {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 48px 28px 48px 0;
		min-width: 0;
	}
	.col-item + .col-item {
		padding-left: 28px;
		border-left: 1px solid var(--line);
	}
	.col-item:last-child {
		padding-right: 0;
	}
	.cmds {
		margin-top: auto;
		border-top: 1px solid var(--line);
	}
	.cmds div {
		display: grid;
		grid-template-columns: 6.5em minmax(0, 1fr);
		gap: 10px;
		padding: 10px 0;
		border-bottom: 1px solid var(--line);
		font-size: var(--text-sm);
	}
	.cmds dt code {
		color: var(--link);
