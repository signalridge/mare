		<script is:inline>
			(function () {
				var root = document.documentElement;
				var reduce = matchMedia('(prefers-reduced-motion: reduce)');

				// Borderless header at y = 0; clean separation once scrolled.
				var nav = document.getElementById('site-nav');
				var syncNav = function () {
					nav.classList.toggle('scrolled', window.scrollY > 4);
				};
				syncNav();
				addEventListener('scroll', syncNav, { passive: true });

				// Theme toggle synced with Starlight's storage key.
				var themeBtn = document.getElementById('theme');
				var labels = JSON.parse(themeBtn.dataset.labels);
				var order = ['auto', 'light', 'dark'];
				var light = matchMedia('(prefers-color-scheme: light)');
				function applyTheme(choice) {
					root.dataset.themeChoice = choice;
					root.dataset.theme = choice === 'auto' ? (light.matches ? 'light' : 'dark') : choice;
					themeBtn.setAttribute('aria-label', labels[order.indexOf(choice)]);
					themeBtn.title = labels[order.indexOf(choice)];
				}
				applyTheme(root.dataset.themeChoice || 'auto');
				themeBtn.addEventListener('click', function () {
					var next = order[(order.indexOf(root.dataset.themeChoice) + 1) % order.length];
					try {
						localStorage.setItem('starlight-theme', next === 'auto' ? '' : next);
					} catch (e) {}
					applyTheme(next);
				});
				light.addEventListener('change', function () {
					if (root.dataset.themeChoice === 'auto') applyTheme('auto');
				});

				// Close the language menu on Escape or outside click.
				var menu = document.querySelector('details.menu');
				document.addEventListener('click', function (e) {
					if (menu.open && !menu.contains(e.target)) menu.open = false;
				});
				menu.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') {
						menu.open = false;
						menu.querySelector('summary').focus();
					}
				});

				// Scroll reveals (elements start visible if JS disabled or reduced motion).
				var revealed = document.querySelectorAll('.reveal');
				if (reduce.matches || !('IntersectionObserver' in window)) {
					revealed.forEach(function (el) {
						el.classList.add('in');
					});
				} else {
					var io = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (e) {
								if (e.isIntersecting) {
									e.target.classList.add('in');
									io.unobserve(e.target);
								}
							});
						},
						{ rootMargin: '0px 0px -6% 0px' },
					);
					revealed.forEach(function (el) {
						io.observe(el);
					});
				}

				// Video helper for both hero recording and optional architecture video.
				function wireVideo(videoId, playId) {
					var video = document.getElementById(videoId);
					var play = document.getElementById(playId);
					if (!video || !play) return;
					var userPaused = reduce.matches;
					function syncButton() {
						var playing = !video.paused;
						play.classList.toggle('playing', playing);
						play.setAttribute('aria-label', playing ? play.dataset.pause : play.dataset.play);
					}
					video.addEventListener('play', syncButton);
					video.addEventListener('pause', syncButton);
					play.addEventListener('click', function () {
						if (video.paused) {
							userPaused = false;
							video.play().catch(function () {});
						} else {
							userPaused = true;
							video.pause();
						}
					});
					if ('IntersectionObserver' in window) {
						new IntersectionObserver(
							function (entries) {
								entries.forEach(function (e) {
									if (e.isIntersecting && !userPaused) video.play().catch(function () {});
									else if (!e.isIntersecting) video.pause();
								});
							},
							{ threshold: 0.25 },
						).observe(video);
					}
					syncButton();
				}
				wireVideo('arch-video', 'arch-play');

				// Interactive permission preset switcher.
				var presetGroup = document.querySelector('[data-preset-group]');
				if (presetGroup) {
					var presetFlag = document.querySelector('[data-preset-flag]');
					var presetSummary = document.querySelector('[data-preset-summary]');
					var presetBtns = Array.prototype.slice.call(presetGroup.querySelectorAll('[role="radio"]'));
					presetBtns.forEach(function (btn) {
						btn.addEventListener('click', function () {
							presetBtns.forEach(function (b) {
								b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
							});
							if (presetFlag) presetFlag.textContent = btn.dataset.flag;
							if (presetSummary) presetSummary.textContent = btn.dataset.summary;
						});
					});
				}

				// Interactive reasoning effort selector.
				var effortGroup = document.querySelector('[data-effort-group]');
				if (effortGroup) {
					var effortCmd = document.querySelector('[data-effort-cmd]');
					var effortBtns = Array.prototype.slice.call(effortGroup.querySelectorAll('[role="radio"]'));
					effortBtns.forEach(function (btn) {
						btn.addEventListener('click', function () {
							effortBtns.forEach(function (b) {
								b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
							});
							var lvl = btn.dataset.level;
							if (effortCmd) effortCmd.textContent = '/effort ' + lvl + '  ·  mare --effort ' + lvl;
						});
					});
				}

				// Install tabs (WAI-ARIA tabs pattern) with OS detection.
				var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
				function select(tab, focus) {
					tabs.forEach(function (t) {
						var on = t === tab;
						t.setAttribute('aria-selected', on ? 'true' : 'false');
						t.tabIndex = on ? 0 : -1;
						document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
					});
					if (focus) tab.focus();
				}
				tabs.forEach(function (tab, i) {
					tab.addEventListener('click', function () {
						select(tab, false);
					});
					tab.addEventListener('keydown', function (e) {
						var n = null;
						if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
						else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
						else if (e.key === 'Home') n = 0;
						else if (e.key === 'End') n = tabs.length - 1;
						if (n !== null) {
							e.preventDefault();
							select(tabs[n], true);
						}
					});
				});
				var uaPlatform = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '') + ' ' + navigator.userAgent;
				var os = /win/i.test(uaPlatform)
					? 'windows'
					: /iphone|ipad|android/i.test(uaPlatform)
						? null
						: /mac/i.test(uaPlatform)
							? 'macos'
							: /linux|x11|bsd/i.test(uaPlatform)
								? 'linux'
								: null;
				function markTargets(arch) {
					document.querySelectorAll('.targets li').forEach(function (li) {
						var hit = li.dataset.os === os && (!arch || li.dataset.arch === arch);
						li.classList.toggle('mine', hit);
					});
				}
				if (os) {
					var mine = document.getElementById('tab-' + os);
					if (mine) {
						mine.querySelector('.detected').hidden = false;
						select(mine, false);
						markTargets(null);
					}
					if (navigator.userAgentData && navigator.userAgentData.getHighEntropyValues) {
						navigator.userAgentData
							.getHighEntropyValues(['architecture'])
							.then(function (v) {
								if (v.architecture === 'arm' || v.architecture === 'x86') markTargets(v.architecture);
							})
							.catch(function () {});
					}
				}

				// Copy buttons.
				document.querySelectorAll('button[data-copy]').forEach(function (btn) {
					var target = btn.querySelector('span') || btn;
					var label = target.textContent;
					btn.addEventListener('click', function () {
						if (!navigator.clipboard) return;
						navigator.clipboard.writeText(btn.dataset.copy).then(function () {
							target.textContent = btn.dataset.copied;
							btn.classList.add('done');
							setTimeout(function () {
								target.textContent = label;
								btn.classList.remove('done');
							}, 1600);
						});
					});
				});

				// Fetch latest release tag and direct asset links.
				fetch('https://api.github.com/repos/signalridge/mare/releases/latest', { headers: { Accept: 'application/vnd.github+json' } })
					.then(function (r) {
						return r.ok ? r.json() : null;
					})
					.then(function (rel) {
						if (!rel || !/^v\d+\.\d+\.\d+/.test(rel.tag_name || '')) return;
						var tag = rel.tag_name;
						document.querySelectorAll('[data-release-tag]').forEach(function (el) {
							el.textContent = tag;
						});
						document.querySelectorAll('.release').forEach(function (el) {
							el.hidden = false;
						});
						var names = (rel.assets || []).map(function (a) {
							return a.name;
						});
						document.querySelectorAll('[data-target]').forEach(function (a) {
							var file = 'mare-' + tag + '-' + a.dataset.target + '.' + a.dataset.ext;
							if (names.indexOf(file) !== -1) a.href = 'https://github.com/signalridge/mare/releases/download/' + tag + '/' + file;
						});
					})
					.catch(function () {});
			})();
		</script>

		<script>
			import { create } from 'asciinema-player';
			import 'asciinema-player/dist/bundle/asciinema-player.css';

			const mount = document.getElementById('demo-player');
			const castUrl = mount?.dataset.cast;
			if (mount && castUrl) {
				const reduce = matchMedia('(prefers-reduced-motion: reduce)');
				const narrow = matchMedia('(max-width: 640px)').matches;
				const src = narrow && mount.dataset.castMobile ? mount.dataset.castMobile : castUrl;
				const poster = mount.querySelector('.demo-poster');
				if (poster) poster.remove();

				const player = create(src, mount, {
					cols: narrow ? 72 : 116,
					rows: 26,
					fit: 'width',
					theme: 'catppuccin-mocha',
					terminalFontFamily: "'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					terminalLineHeight: 1.33333333,
					autoPlay: !reduce.matches,
					loop: true,
					preload: true,
					controls: 'auto',
					idleTimeLimit: 2.0,
					poster: 'npt:0.35',
				});

				let userPaused = reduce.matches;
				let autoPausing = false;
				player.addEventListener('pause', () => {
					if (!autoPausing) userPaused = true;
				});
				player.addEventListener('play', () => {
					userPaused = false;
				});

				if ('IntersectionObserver' in window) {
					new IntersectionObserver(
						(entries) => {
							for (const e of entries) {
								if (e.isIntersecting) {
									if (!userPaused) {
										player.play().catch(() => {});
									}
								} else {
									autoPausing = true;
									Promise.resolve(player.pause())
										.catch(() => {})
										.finally(() => {
											autoPausing = false;
										});
								}
							}
						},
						{ threshold: 0.25 },
					).observe(mount);
				}
			}
		</script>
	</body>
